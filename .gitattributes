# Keep deployable source and documentation consistent across Windows, WSL, and Linux.
* text=auto eol=lf

# Windows command scripts require CRLF when executed by cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never attempt line-ending conversion for binary assets.
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
*.wav binary

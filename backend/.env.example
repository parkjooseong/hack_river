STORAGE_BACKEND=sqlite

# Supabase를 사용할 때만 입력합니다. Secret key는 백엔드 외부에 노출하지 마세요.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_TABLE=responses
SUPABASE_TIMEOUT_SECONDS=10
SUPABASE_AUTH_TIMEOUT_SECONDS=10

# Supabase Authentication > Users에 만든 후보자 전용 계정 이메일입니다.
# 비밀번호는 .env에 저장하지 않고 Supabase Auth에서만 설정합니다.
CANDIDATE_AUTH_EMAIL=candidate@example.com
LOG_LEVEL=INFO

API_HOST=127.0.0.1
API_PORT=8000
DATABASE_PATH=./data/river_api.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 운영 배포에서 Supabase 백업 정책을 직접 확인한 뒤 true로 바꿉니다.
BACKUP_POLICY_CONFIRMED=false
